# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MAMAAI
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_SECRET_KEY=your-admin-dashboard-secret
MAMA_AI_ALLOW_DEMO_IDENTITY=false
MAMA_AI_ALLOWED_ORIGINS=http://localhost:3000,https://www.mamaai.in,https://mamaai.in

# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AWS & Infrastructure
AWS_REGION=ap-south-1
AWS_ROLE_ARN=
MAMA_AI_DYNAMODB_TABLE_NAME=your-explicit-table-name
MAMA_AI_DYNAMODB_GSI1_NAME=GSI1
MAMA_AI_ANALYTICS_TABLE_NAME=your-explicit-analytics-table-name
# Required only for isolated Preview/test deployments: preview-isolated or test-isolated.
MAMA_AI_AWS_IDENTITY_SCOPE=
# Required in the separate Vercel project's Production environment only.
MAMA_AI_ISOLATED_PREVIEW=false
MAMA_AI_DYNAMODB_GSI2_NAME=GSI2
MAMA_AI_S3_BUCKET=

# Subscriptions & Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_public_key_id
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_PREMIUM_MONTHLY=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_STARTER_USD=
RAZORPAY_PLAN_PREMIUM_USD=
RAZORPAY_PLAN_PLUS_USD=
REVENUECAT_API_KEY=

# Third Party APIs
YOUTUBE_API_KEY=

# Development
MAMA_AI_DEMO_MODE=false
## Beta access is only valid in a separately isolated protected deployment.
MAMA_AI_BETA_ACCESS_ENABLED=false
MAMA_AI_BETA_END_AT=
MAMA_AI_BETA_PLAN=premium

# Recovery challenge hashing only; does not enable SMS/email delivery.
# At least 32 random characters. Keep existing identity/recovery peppers unchanged.
MAMA_AI_RECOVERY_CHALLENGE_SECRET=
